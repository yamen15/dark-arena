<style>

*{
  padding: 0;
color: white ;
}


:global(body) {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #0F0F10;
  margin: 0;
  padding: 0;
  font-family: "Playpen Sans Arabic", cursive;
}

main {
  flex: 1;
  width: 100%;
}


 /* لتحديد لون تحديد النصوص */
::selection {
  background: rgba(62, 166, 255, 0.35);
  color: #ffffff;
}

::-moz-selection {
  background: rgba(62, 166, 255, 0.35);
  color: #ffffff;
}


/* =====================header settings======================== */

/* رأس الموقع */
.header {
  position: sticky;
  top: 0;
  left: 0;
  width: 100%;
  height: 75px;
  background: #181818;
  border-bottom: 1px #ffffff39 solid;
  z-index: 1000;
}

.header-inner{
  max-width: 1000px;
  /* width: 100%; */
  height: 100%;
  padding: 0px 20px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}



.header a {
  text-decoration: none;
}



.logo {
  color: #fff;
  font-size: 26px;
  font-weight:500;
}




.search-box {
  display: flex;
  align-items: center;
  border: 2px solid rgba(255,255,255,0.06);
  border-radius: 20px;
  overflow: hidden;

}   


.search-box input {
  width: 250px;
  height: 35px;
  border: none;
  outline: none;
  background: #121212;
  color: #fff;
}

.search-box button {
  background: #222;
  border: none;
  /* padding: 0px 14px; */
  cursor: pointer;
}

.search-box svg{
  height: 18px;
  fill: #ffffff80;
}

.search-box:focus-within{
  border-color: #eafa5b3f;
}

/* socials */

.socials-container{
  display: flex;
  gap: 20px;
  /* padding-left: 100px; */
}

.socials-container svg{
  height: 20px;
  fill: #fff;
  transition: 0.3s;
}

.socials-container a:hover svg{
  fill: #ffffff74;
}









/* =====================footer settings======================== */


footer {
  background: #141416;
  color: #bcbcbc;
  text-align: center;
  padding: 10px;
  /* width: 100%; */
  font-size: 13px;
 bottom: 0px;
}

footer p {
  display: inline-block;
  
}

a.Aboutme {
  text-decoration: none;
  display: inline-block;
  color: #bcbcbc;
  margin-left: 50px;
}


</style>