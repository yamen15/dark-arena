---
interface Props {
  title: string;
  searchData?: {
    title: string;
    slug: string;
    description?: string;
    tags: string[];
  }[];
}
const { title, searchData = [] } = Astro.props;
const currentPath = Astro.url.pathname;
// ✅ base يعمل مع أي سيرفر - يضيف البادئة تلقائياً فقط عند الحاجة
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- ✅ الخط محمّل محلياً من public/fonts - لا يحتاج إنترنت -->
    <link
      rel="preload"
      href={`${base}/fonts/PlaypenSansArabic.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style>
      @font-face {
        font-family: "Playpen Sans Arabic";
        src: url("/fonts/PlaypenSansArabic.woff2") format("woff2");
        font-weight: 100 800;
        font-style: normal;
        font-display: swap;
      }
    </style>
  </head>
  <body>
    <header>
      <nav class="nav-container">
        <a href={`${base}/`} class="logo">الساحة المظلمة</a>

        <!-- زر البحث ظاهر دائماً في الهيدر -->
        <button class="search-btn" id="searchBtn" aria-label="بحث">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
            ></path>
          </svg>
          <span class="search-label"></span>
        </button>

        <!-- زر الهامبرغر -->
        <button class="menu-btn" id="menuBtn" aria-label="القائمة">
          <span></span><span></span><span></span>
        </button>

        <div class="nav-drawer" id="navDrawer">
          <ul class="nav-links">
            <li>
              <a
                href={`${base}/`}
                class={currentPath === "/" || currentPath === `${base}/`
                  ? "active"
                  : ""}>الرئيسية</a
              >
            </li>
            <li>
              <a
                href={`${base}/posts`}
                class={currentPath.startsWith("/posts") ? "active" : ""}
                >المقالات</a
              >
            </li>
            <li>
              <a
                href={`${base}/about`}
                class={currentPath === "/about" ||
                currentPath === `${base}/about`
                  ? "active"
                  : ""}>عن الموقع</a
              >
            </li>
          </ul>
        </div>
      </nav>
    </header>

    <!-- نافذة البحث -->
    <div class="search-overlay" id="searchOverlay">
      <div class="search-modal">
        <div class="search-input-wrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="search-icon-input"
          >
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
            ></path>
          </svg>
          <input
            type="text"
            id="searchInput"
            placeholder="ابحث في المقالات..."
            autocomplete="off"
          />
          <kbd class="search-kbd">ESC</kbd>
        </div>
        <div class="search-results" id="searchResults">
          <p class="search-hint">اكتب للبحث في المقالات...</p>
        </div>
      </div>
    </div>

    <main><slot /></main>

    <footer>
      <div class="footer-container">
        <p>جميع الحقوق محفوظة © {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>

<script define:vars={{ searchData, base }}>
  const posts = searchData;
  const searchBtn = document.getElementById("searchBtn");
  const searchOverlay = document.getElementById("searchOverlay");
  const searchInput = document.getElementById("searchInput");
  const searchResults = document.getElementById("searchResults");
  const menuBtn = document.getElementById("menuBtn");
  const navDrawer = document.getElementById("navDrawer");

  menuBtn.addEventListener("click", () => {
    navDrawer.classList.toggle("open");
    menuBtn.classList.toggle("open");
  });
  document.querySelectorAll(".nav-links a").forEach((link) => {
    link.addEventListener("click", () => {
      navDrawer.classList.remove("open");
      menuBtn.classList.remove("open");
    });
  });

  function openSearch() {
    searchOverlay.classList.add("active");
    setTimeout(() => searchInput.focus(), 50);
    document.body.style.overflow = "hidden";
  }
  function closeSearch() {
    searchOverlay.classList.remove("active");
    searchInput.value = "";
    searchResults.innerHTML =
      '<p class="search-hint">اكتب للبحث في المقالات...</p>';
    document.body.style.overflow = "";
  }

  searchBtn.addEventListener("click", openSearch);
  searchOverlay.addEventListener("click", (e) => {
    if (e.target === searchOverlay) closeSearch();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSearch();
    if ((e.ctrlKey || e.metaKey) && e.key === "k") {
      e.preventDefault();
      searchOverlay.classList.contains("active") ? closeSearch() : openSearch();
    }
  });

  function highlight(text, query) {
    return text.replace(
      new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi"),
      "<mark>$1</mark>",
    );
  }

  searchInput.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();
    if (!query) {
      searchResults.innerHTML =
        '<p class="search-hint">اكتب للبحث في المقالات...</p>';
      return;
    }
    const results = posts.filter(
      (p) =>
        p.title.toLowerCase().includes(query) ||
        (p.description && p.description.toLowerCase().includes(query)) ||
        p.tags.some((t) => t.toLowerCase().includes(query)),
    );
    if (!results.length) {
      searchResults.innerHTML = `<p class="search-empty">لا نتائج لـ "<strong>${query}</strong>"</p>`;
      return;
    }
    searchResults.innerHTML = results
      .map(
        (p) => `
      <a class="search-result-item" href="${base}/posts/${p.slug}">
        <span class="result-title">${highlight(p.title, query)}</span>
        ${p.description ? `<span class="result-desc">${highlight(p.description, query)}</span>` : ""}
        <div class="result-tags">${p.tags.map((t) => `<span class="result-tag">${t}</span>`).join("")}</div>
      </a>`,
      )
      .join("");
  });
</script>

<style is:global>
  @import "../styles/styles.css";
  ::selection {
    background: rgba(62, 166, 255, 0.35);
    color: #fff;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Playpen Sans Arabic", cursive;
    background: #111213;
    color: #eaeaea;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    padding: 40px 20px;
  }

  /* HEADER */
  header {
    background: #1a1b1ecc;
    border-bottom: 1px solid #ffffff14;
    position: sticky;
    top: 0;
    z-index: 200;
    backdrop-filter: blur(12px);
  }
  .nav-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo {
    font-size: 20px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: auto;
  }
  .logo:hover {
    color: #3ea6ff;
  }

  /* روابط - على اليسار من اللوجو */
  .nav-drawer {
    display: flex;
    align-items: center;
  }
  .nav-links {
    list-style: none;
    display: flex;
    gap: 22px;
  }
  .nav-links a {
    color: #cdcdcd;
    text-decoration: none;
    font-size: 15px;
    transition: color 0.2s;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: #fff;
    border-bottom-color: #3ea6ff;
  }

  /* زر البحث - ظاهر دائماً */
  .search-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ffffff0f;
    border: 1px solid #ffffff18;
    color: #cdcdcd;
    height: 36px;
    padding: 0 8px;
    border-radius: 8px;
    cursor: pointer;
    flex-shrink: 0;
    transition:
    background  0.2s,
      color 0.2s;
  }
  .search-btn:hover {
    background: #ffffff18;
    color: #fff;
  }

  /* هامبرغر - مخفي على الديسكتوب */
  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    flex-shrink: 0;
  }
  .menu-btn span {
    display: block;
    width: 22px;
    height: 2px;
    background: #cdcdcd;
    border-radius: 2px;
    transition:
      transform 0.25s,
      opacity 0.25s;
  }
  .menu-btn.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-btn.open span:nth-child(2) {
    opacity: 0;
  }
  .menu-btn.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* SEARCH */
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    z-index: 999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 80px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .search-overlay.active {
    opacity: 1;
    pointer-events: all;
  }
  .search-modal {
    background: #1c1d20;
    border: 1px solid #ffffff1a;
    border-radius: 16px;
    width: 100%;
    max-width: 580px;
    margin: 0 16px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
    transform: translateY(-16px);
    transition: transform 0.25s;
  }
  .search-overlay.active .search-modal {
    transform: translateY(0);
  }
  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid #ffffff10;
  }
  .search-icon-input {
    color: #555;
    flex-shrink: 0;
  }
  #searchInput {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-size: 16px;
    font-family: "Playpen Sans Arabic", cursive;
  }
  #searchInput::placeholder {
    color: #555;
  }
  .search-kbd {
    font-size: 11px;
    padding: 3px 6px;
    background: #ffffff0a;
    border: 1px solid #ffffff14;
    border-radius: 5px;
    color: #555;
    flex-shrink: 0;
  }
  .search-results {
    max-height: 400px;
    overflow-y: auto;
    padding: 8px;
  }
  .search-hint,
  .search-empty {
    text-align: center;
    color: #555;
    font-size: 14px;
    padding: 32px 16px;
  }
  .search-empty strong {
    color: #cdcdcd;
  }
  .search-result-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 12px 14px;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .search-result-item:hover {
    background: #ffffff08;
    border-color: #ffffff10;
  }
  .result-title {
    font-size: 15px;
    font-weight: 500;
    color: #fff;
    line-height: 1.5;
  }
  .result-desc {
    font-size: 13px;
    color: #777;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }
  .result-tag {
    font-size: 11px;
    padding: 2px 8px;
    background: #ffffff08;
    border: 1px solid #ffffff0f;
    border-radius: 999px;
    color: #666;
  }
  mark {
    background: transparent;
    color: #3ea6ff;
    font-weight: 600;
  }

  /* FOOTER */
  footer {
    background: #1a1b1e;
    border-top: 1px solid #ffffff14;
    padding: 16px 20px;
  }
  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
    color: #cdcdcd;
    font-size: 14px;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    main {
      padding: 24px 14px;
    }
    .menu-btn {
      display: flex;
    }
    .search-label {
      display: none;
    }
    .search-btn {
      width: 36px;
      height: 36px;
      padding: 0;
      justify-content: center;
    }

    /* الدراور */
    .nav-drawer {
      display: none;
      position: absolute;
      top: 60px;
      right: 0;
      left: 0;
      background: #1a1b1ef5;
      border-bottom: 1px solid #ffffff14;
      backdrop-filter: blur(12px);
      flex-direction: column;
      padding: 8px 20px 16px;
    }
    .nav-drawer.open {
      display: flex;
    }
    .nav-links {
      flex-direction: column;
      gap: 0;
      width: 100%;
    }
    .nav-links li a {
      display: block;
      padding: 12px 0;
      font-size: 16px;
      border-bottom: 1px solid #ffffff08 !important;
    }
    .nav-links li:last-child a {
      border-bottom: none !important;
    }
    .nav-links a.active {
      color: #3ea6ff;
      border-bottom-color: transparent !important;
    }

    .search-overlay {
      padding-top: 16px;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .logo {
      font-size: 17px;
    }
    main {
      padding: 16px 12px;
    }
  }
</style>
