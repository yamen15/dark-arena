---
// PostCard.astro - مكون بطاقة المقال
interface Props {
  title: string;
  slug: string;
  image: string;
  tags: string[];
  readTime: string;
  views: number;

}

const { title, slug, image, tags, readTime, views } = Astro.props;
---

<article class="post-card">
  <a href={`/posts/${slug}`} class="post-link">

    <div class="post-thumbnail">
      <!--  إصلاح: إضافة loading="lazy" لتحسين الأداء -->
      <!--  إصلاح: إضافة decoding="async" -->
      <img src={image} alt={title} loading="lazy" />
    </div>

    <div class="post-body">
      <h3 class="post-title">{title}</h3>


      <div class="post-meta">
        <span class="post-views">👁 {views.toLocaleString('ar-SA')} مشاهدة</span>
        <span class="post-readtime">⏱ {readTime}</span>
      </div>

      <div class="tags-container">
        {tags.map((tag) => (
          <a
            class="tag"
            href={`/tags/${tag}`}
            onclick="event.stopPropagation()"
          >{tag}</a>
        ))}
      </div>
    </div>

  </a>
</article>

<style>
.post-card {
  background: #1A1B1E;
  border-radius: 14px;
  border: 2px dashed #ffffff18;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  display: flex;
  flex-direction: column;
}

.post-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
  background: #202226;
  border-color: #ffffff28;
}

.post-link {
  display: flex;
  flex-direction: column;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

.post-thumbnail {
  overflow: hidden;
  
}

.post-thumbnail img {
  width: 100%;
  display: block;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.post-card:hover .post-thumbnail img {
  transform: scale(1.04);
}

.post-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.post-title {
  margin: 0 0 8px;
  font-weight: 600;
  font-size: 17px;
  color: #FFFFFF;
  line-height: 1.6;
}



.post-meta {
  display: flex;
  gap: 12px;
  font-size: 13px;
  color: #CDCDCD;
  margin-bottom: 12px;
  /*  إضافة: دفع الميتا للأسفل تلقائياً */
  margin-top: auto;
  padding-top: 10px;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.tag {
  font-size: 13px;
  padding: 3px 10px;
  border: 1px solid #ffffff14;
  background: #ffffff0a;
  border-radius: 999px;
  color: #CDCDCD;
  text-decoration: none;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
}

.tag:hover {
  background: #3ea6ff20;
  color: #3EA6FF;
  border-color: #3ea6ff40;
}
</style>
