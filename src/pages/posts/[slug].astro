---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id.replace(".md", "") },
    props: { post },
  }));
}

const allPosts = await getCollection("posts");
const searchData = allPosts.map((post) => ({
  title: post.data.title,
  slug: post.id.replace(".md", ""),
  tags: post.data.tags,
}));

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title={`${post.data.title} - الساحة المظلمة`} searchData={searchData}>
  <article class="post-page">
    <!-- صورة الغلاف -->
    <div class="post-hero">
      <img
        src={post.data.image.startsWith("/")
          ? `${base}${post.data.image}`
          : post.data.image}
        alt={post.data.title}
        loading="eager"
      />
    </div>

    <header class="post-header">
      <div class="tags-container">
        {
          post.data.tags.map((tag) => (
            <a class="tag" href={`${base}/tags/${tag}`}>
              {tag}
            </a>
          ))
        }
      </div>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <span
          >📅 {
            post.data.pubDate.toLocaleDateString("ar-SA", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }</span
        >
        <span>⏱ {post.data.readTime}</span>
        <span>👁 {post.data.views.toLocaleString("en")} مشاهدة</span>
      </div>
    </header>

    <hr class="divider" />

    <div class="post-content">
      <Content />
    </div>

    <div class="back-link">
      <a href={`${base}/`}>← العودة للرئيسية</a>
    </div>
  </article>
</Layout>

<style>
  .post-page {
    max-width: 750px;
    margin: 0 auto;
  }

  .post-hero {
    margin-bottom: 32px;
  }
  .post-hero img {
    width: 100%;
    border-radius: 14px;
    aspect-ratio: 16/9;
    object-fit: cover;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
  }

  .post-header {
    margin-bottom: 28px;
  }
  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .tag {
    font-size: 13px;
    padding: 3px 10px;
    border: 1px solid #ffffff14;
    background: #ffffff0a;
    border-radius: 999px;
    color: #cdcdcd;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .tag:hover {
    background: #3ea6ff20;
    color: #3ea6ff;
    border-color: #3ea6ff40;
  }

  h1 {
    font-size: 28px;
    font-weight: 600;
    color: #fff;
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    color: #cdcdcd;
    font-size: 14px;
  }

  .divider {
    border: none;
    border-top: 1px solid #ffffff14;
    margin: 28px 0;
  }

  .post-content {
    color: #eaeaea;
    line-height: 1.9;
    font-size: 17px;
  }
  .post-content h2 {
    font-size: 22px;
    font-weight: 600;
    color: #fff;
    margin: 36px 0 14px;
    border-right: 3px solid #3ea6ff;
    padding-right: 12px;
  }
  .post-content h3 {
    font-size: 19px;
    color: #fff;
    margin: 26px 0 10px;
  }
  .post-content p {
    margin-bottom: 16px;
  }
  .post-content ul,
  .post-content ol {
    padding-right: 24px;
    margin-bottom: 16px;
  }
  .post-content li {
    margin-bottom: 6px;
  }
  .post-content a {
    color: #3ea6ff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-content code {
    background: #ffffff12;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 15px;
    border: 1px solid #ffffff14;
  }
  .post-content pre {
    background: #1a1b1e;
    border: 1px solid #ffffff14;
    border-radius: 10px;
    padding: 20px;
    overflow-x: auto;
    margin-bottom: 20px;
  }
  .post-content pre code {
    background: transparent;
    border: none;
    padding: 0;
  }
  .post-content blockquote {
    border-right: 3px solid #3ea6ff;
    padding: 12px 16px;
    margin: 20px 0;
    background: #ffffff06;
    border-radius: 0 8px 8px 0;
    color: #cdcdcd;
  }

  .back-link {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid #ffffff14;
  }
  .back-link a {
    color: #cdcdcd;
    text-decoration: none;
    font-size: 15px;
    transition: color 0.2s;
  }
  .back-link a:hover {
    color: #3ea6ff;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 22px;
    }
    .post-content {
      font-size: 15px;
    }
    .post-hero img {
      border-radius: 10px;
    }
    .post-meta {
      gap: 10px;
      font-size: 13px;
    }
  }
</style>
