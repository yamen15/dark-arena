---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace('.md', '') },
    props: { post },
  }));
}

const { post } = Astro.props;

// ✅ Astro 5: render() تُستورد من 'astro:content' مباشرة
const { Content } = await render(post);
---

<Layout title={`${post.data.title} - مدونتي`}>
  <article class="post-page">

    <div class="post-hero">
      <img src={post.data.image} alt={post.data.title} loading="eager" />
    </div>

    <header class="post-header">
      <div class="tags-container">
        {post.data.tags.map((tag) => (
          <a class="tag" href={`/tags/${tag}`}>{tag}</a>
        ))}
      </div>

      <h1>{post.data.title}</h1>

      {post.data.description && (
        <p class="post-description">{post.data.description}</p>
      )}

      <div class="post-meta">
        <span>📅 {post.data.pubDate.toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <span>⏱ {post.data.readTime}</span>
        <span>👁 {post.data.views.toLocaleString('ar-SA')} مشاهدة</span>
      </div>
    </header>

    <hr class="divider" />

    <div class="post-content">
      <Content />
    </div>

    <div class="back-link">
      <a href="/">← العودة للرئيسية</a>
    </div>

  </article>
</Layout>

<style>
.post-page { max-width: 750px; margin: 0 auto; }
.post-hero img { width: 100%; border-radius: 14px; aspect-ratio: 16/9; object-fit: cover; margin-bottom: 32px; box-shadow: 0 4px 30px rgba(0,0,0,0.4); }
.post-header { margin-bottom: 32px; }
.tags-container { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
.tag { font-size: 13px; padding: 3px 10px; border: 1px solid #ffffff14; background: #ffffff0a; border-radius: 999px; color: #CDCDCD; text-decoration: none; transition: background 0.2s, color 0.2s; }
.tag:hover { background: #3ea6ff20; color: #3EA6FF; border-color: #3ea6ff40; }
h1 { font-size: 30px; font-weight: 700; color: #fff; line-height: 1.5; margin-bottom: 12px; }
.post-description { font-size: 17px; color: #AAAAAA; line-height: 1.7; margin-bottom: 16px; }
.post-meta { display: flex; flex-wrap: wrap; gap: 16px; color: #CDCDCD; font-size: 14px; }
.divider { border: none; border-top: 1px solid #ffffff14; margin: 32px 0; }
.post-content { color: #EAEAEA; line-height: 1.9; font-size: 17px; }
.post-content h2 { font-size: 24px; font-weight: 600; color: #fff; margin: 40px 0 16px; border-right: 3px solid #3EA6FF; padding-right: 12px; }
.post-content h3 { font-size: 20px; color: #fff; margin: 28px 0 12px; }
.post-content p { margin-bottom: 18px; }
.post-content ul, .post-content ol { padding-right: 24px; margin-bottom: 18px; }
.post-content li { margin-bottom: 8px; }
.post-content a { color: #3EA6FF; text-decoration: underline; text-underline-offset: 3px; }
.post-content code { background: #ffffff12; padding: 2px 8px; border-radius: 6px; font-size: 15px; border: 1px solid #ffffff14; }
.post-content pre { background: #1A1B1E; border: 1px solid #ffffff14; border-radius: 10px; padding: 20px; overflow-x: auto; margin-bottom: 24px; }
.post-content pre code { background: transparent; border: none; padding: 0; }
.post-content blockquote { border-right: 3px solid #3EA6FF; padding: 12px 16px; margin: 20px 0; background: #ffffff06; border-radius: 0 8px 8px 0; color: #CDCDCD; }
.back-link { margin-top: 48px; padding-top: 24px; border-top: 1px solid #ffffff14; }
.back-link a { color: #CDCDCD; text-decoration: none; font-size: 15px; transition: color 0.2s; }
.back-link a:hover { color: #3EA6FF; }
@media (max-width: 600px) { h1 { font-size: 24px; } .post-content { font-size: 16px; } }
</style>
