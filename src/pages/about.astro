---
import Layout from "../layouts/Layout.astro";
---

<Layout title="عن الموقع - الساحة المظلمة">
  <section class="hero">
    <div class="hero-card fade-up">
      <div class="avatar-wrap">
        <img class="avatar" src="./img/avatar.png" alt="avatar" loading="lazy" />
        <div class="avatar-ring"></div>
      </div>
      <h1 class="name">yamen</h1>
      <p class="tagline">مطوّر ويب · كاتب تقني</p>
      <div class="links">
        <a
          target="_blank"
          href="https://x.com/yamenflash123"
          aria-label="X"
          class="social-link"
        >
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"
            ></path></svg
          >
        </a>
        <a
          target="_blank"
          href="https://github.com/yamen15"
          aria-label="GitHub"
          class="social-link"
        >
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path></svg
          >
        </a>
        <a
          target="_blank"
          href="https://www.youtube.com/@yamenlimao"
          aria-label="YouTube"
          class="social-link"
        >
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
            ></path></svg
          >
        </a>
      </div>
    </div>

    <div class="hero-text fade-up delay-1">
      <div class="quote-block">
        <span class="quote-mark">"</span>
        <p>
          في عالمٍ يضجُّ بالأصوات، اختار شابٌّ في مطلع دربه أن يشقَّ لنفسه
          مسارًا مختلفًا بين قممٍ رقميةٍ لا تهدأ. هناك، وُلدت "الساحة المظلمة" —
          ملاذٌ للكلمات، ومرفأٌ للأفكار.
        </p>
      </div>
      <p class="bio-sub">
        مرحبًا في مدونتي المتواضعة، هنا أكتب عن التقنية والبرمجة وكل ما يعبر
        ذهني من رؤى رقمية.
      </p>
    </div>
  </section>

  <section class="skills-section fade-up delay-2">
    <h2 class="section-title">المهارات</h2>
    <div class="skills-grid">
      <div class="skill-card">
        <div class="skill-icon html">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M1.5 0h21l-1.91 21.563L11.977 24l-8.564-2.438L1.5 0zm7.031 9.75l-.232-2.718 10.059.003.23-2.622L5.412 4.41l.698 8.01h9.126l-.326 3.426-2.91.804-2.955-.81-.188-2.11H6.248l.33 4.171L12 19.351l5.379-1.443.744-8.157H8.531z"
            ></path></svg
          >
        </div>
        <div class="skill-info">
          <span class="skill-name">HTML</span><span class="skill-pct">90%</span>
        </div>
        <div class="skill-bar"><div class="skill-fill html-fill"></div></div>
      </div>

      <div class="skill-card">
        <div class="skill-icon css">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M1.5 0h21l-1.91 21.563L11.977 24l-8.565-2.438L1.5 0zm17.09 4.413L5.41 4.41l.213 2.622 10.125.002-.255 2.716h-6.64l.24 2.573h6.182l-.366 3.523-2.91.804-2.956-.81-.188-2.11h-2.61l.29 3.855L12 19.288l5.373-1.53L18.59 4.414z"
            ></path></svg
          >
        </div>
        <div class="skill-info">
          <span class="skill-name">CSS</span><span class="skill-pct">85%</span>
        </div>
        <div class="skill-bar"><div class="skill-fill css-fill"></div></div>
      </div>

      <div class="skill-card">
        <div class="skill-icon js">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M0 0h24v24H0V0zm22.034 18.276c-.175-1.095-.888-2.015-3.003-2.873-.736-.345-1.554-.585-1.797-1.14-.091-.33-.105-.51-.046-.705.15-.646.915-.84 1.515-.66.39.12.75.42.976.9 1.034-.676 1.034-.676 1.755-1.125-.27-.42-.404-.601-.586-.78-.63-.705-1.469-1.065-2.834-1.034l-.705.089c-.676.165-1.32.525-1.71 1.005-1.14 1.291-.811 3.541.569 4.471 1.365 1.02 3.361 1.244 3.616 2.205.24 1.17-.87 1.545-1.966 1.41-.811-.18-1.26-.586-1.755-1.336l-1.83 1.051c.21.48.45.689.81 1.109 1.74 1.756 6.09 1.666 6.871-1.004.029-.09.24-.705.074-1.65l.046.067zm-8.983-7.245h-2.248c0 1.938-.009 3.864-.009 5.805 0 1.232.063 2.363-.138 2.711-.33.689-1.18.601-1.566.48-.396-.196-.597-.466-.83-.855-.063-.105-.11-.196-.127-.196l-1.825 1.125c.305.63.75 1.172 1.324 1.517.855.51 2.004.675 3.207.405.783-.226 1.458-.691 1.811-1.411.51-.93.402-2.07.397-3.346.012-2.054 0-4.109 0-6.179l.004-.056z"
            ></path></svg
          >
        </div>
        <div class="skill-info">
          <span class="skill-name">JavaScript</span><span class="skill-pct"
            >75%</span>
        </div>
        <div class="skill-bar"><div class="skill-fill js-fill"></div></div>
      </div>

      <div class="skill-card">
        <div class="skill-icon git">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M23.546 10.93L13.067.452c-.604-.603-1.582-.603-2.188 0L8.708 2.627l2.76 2.76c.645-.215 1.379-.07 1.889.441.516.515.658 1.258.438 1.9l2.658 2.66c.645-.223 1.387-.078 1.9.435.721.72.721 1.884 0 2.604-.719.719-1.881.719-2.6 0-.539-.541-.674-1.337-.404-1.996L12.86 8.955v6.525c.176.086.342.203.488.348.713.721.713 1.883 0 2.6-.719.721-1.889.721-2.609 0-.719-.719-.719-1.879 0-2.598.182-.18.387-.316.605-.406V8.835c-.217-.091-.424-.222-.605-.404-.545-.545-.676-1.342-.396-2.009L7.636 3.7.45 10.881c-.6.605-.6 1.584 0 2.189l10.48 10.477c.604.604 1.582.604 2.186 0l10.43-10.43c.605-.603.605-1.582 0-2.187"
            ></path></svg
          >
        </div>
        <div class="skill-info">
          <span class="skill-name">Git</span><span class="skill-pct">70%</span>
        </div>
        <div class="skill-bar"><div class="skill-fill git-fill"></div></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes ringPulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.45;
    }
    50% {
      transform: scale(1.09);
      opacity: 0.15;
    }
  }
  @keyframes fillHtml {
    from {
      width: 0;
    }
    to {
      width: 90%;
    }
  }
  @keyframes fillCss {
    from {
      width: 0;
    }
    to {
      width: 85%;
    }
  }
  @keyframes fillJs {
    from {
      width: 0;
    }
    to {
      width: 75%;
    }
  }
  @keyframes fillGit {
    from {
      width: 0;
    }
    to {
      width: 70%;
    }
  }

  .fade-up {
    animation: fadeUp 0.65s ease both;
  }
  .delay-1 {
    animation-delay: 0.15s;
  }
  .delay-2 {
    animation-delay: 0.28s;
  }

  /* HERO */
  .hero {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 56px;
    padding: 48px 0 64px;
  }

  .hero-card {
    width: 220px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .avatar-wrap {
    position: relative;
    width: 160px;
    height: 160px;
  }
  .avatar {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #ffffff18;
    position: relative;
    z-index: 1;
    transition:
      transform 0.35s ease,
      border-color 0.35s ease;
  }
  .avatar:hover {
    transform: scale(1.05);
    border-color: #3ea6ff44;
  }
  .avatar-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2px solid #3ea6ff55;
    animation: ringPulse 3s ease-in-out infinite;
  }

  .name {
    font-size: 32px;
    font-weight: 700;
    color: #fff;
  }
  .tagline {
    font-size: 13px;
    color: #3ea6ff;
    background: #3ea6ff10;
    border: 1px solid #3ea6ff28;
    padding: 4px 14px;
    border-radius: 999px;
    text-align: center;
  }

  .links {
    display: flex;
    gap: 10px;
  }
  .social-link {
    width: 38px;
    height: 38px;
    background: #ffffff0a;
    border: 1px solid #ffffff12;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .social-link:hover {
    background: #ffffff16;
    transform: translateY(-3px);
  }
  .social-link svg {
    width: 16px;
    height: 16px;
    fill: #cdcdcd;
    transition: fill 0.2s;
  }
  .social-link:hover svg {
    fill: #fff;
  }

  .hero-text {
    flex: 1;
  }
  .quote-block {
    position: relative;
    padding: 24px 22px 24px 14px;
    border-right: 3px solid #3ea6ff;
    background: #3ea6ff07;
    border-radius: 0 14px 14px 0;
    margin-bottom: 20px;
    overflow: hidden;
  }
  .quote-mark {
    font-size: 72px;
    color: #3ea6ff18;
    position: absolute;
    top: -14px;
    right: 10px;
    line-height: 1;
    font-family: Georgia, serif;
    user-select: none;
  }
  .quote-block p {
    font-size: 17px;
    color: #cdcdcd;
    line-height: 2;
    position: relative;
    z-index: 1;
  }
  .bio-sub {
    font-size: 15px;
    color: #777;
    line-height: 1.9;
    padding-right: 4px;
  }

  /* SKILLS */
  .skills-section {
    max-width: 1100px;
    margin: 0 auto;
    padding-bottom: 60px;
  }
  .section-title {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .section-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, #ffffff14, transparent);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .skill-card {
    background: #1a1b1e;
    border: 1px solid #ffffff0e;
    border-radius: 14px;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition:
      border-color 0.2s,
      transform 0.25s,
      background 0.2s;
  }
  .skill-card:hover {
    border-color: #ffffff1e;
    transform: translateY(-4px);
    background: #1e1f23;
  }

  .skill-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .skill-icon svg {
    width: 22px;
    height: 22px;
  }

  .html {
    background: #e44d261a;
  }
  .html svg {
    fill: #e44d26;
  }
  .css {
    background: #264de41a;
  }
  .css svg {
    fill: #264de4;
  }
  .js {
    background: #f7df1e1a;
  }
  .js svg {
    fill: #f7df1e;
  }
  .git {
    background: #f054321a;
  }
  .git svg {
    fill: #f05032;
  }

  .skill-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .skill-name {
    font-size: 14px;
    font-weight: 500;
    color: #eaeaea;
  }
  .skill-pct {
    font-size: 12px;
    color: #666;
  }

  .skill-bar {
    height: 4px;
    background: #ffffff0a;
    border-radius: 999px;
    overflow: hidden;
  }
  .skill-fill {
    height: 100%;
    border-radius: 999px;
    width: 0;
    animation-duration: 1.1s;
    animation-timing-function: ease;
    animation-delay: 0.4s;
    animation-fill-mode: forwards;
  }
  .html-fill {
    background: #e44d26;
    animation-name: fillHtml;
  }
  .css-fill {
    background: #264de4;
    animation-name: fillCss;
  }
  .js-fill {
    background: #f7df1e;
    animation-name: fillJs;
  }
  .git-fill {
    background: #f05032;
    animation-name: fillGit;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      padding: 32px 0 48px;
      gap: 32px;
      text-align: center;
    }
    .hero-card {
      width: 100%;
    }
    .quote-block {
      text-align: right;
    }
    .quote-block p {
      font-size: 16px;
    }
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .name {
      font-size: 26px;
    }
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .skill-card {
      padding: 14px 12px;
    }
    .skill-name {
      font-size: 13px;
    }
  }
</style>
